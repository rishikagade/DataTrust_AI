# DataTrust AI - Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# -- AI Provider (optional) -----------------------------------------
# The AI agent and report generator work with any OpenAI-compatible API.
# Without a key, the agent uses intelligent rule-based responses.
#
# Option A: Groq (free tier - https://console.groq.com)
# AI_API_KEY=gsk_your_groq_key_here
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
#
# Option B: OpenAI (https://platform.openai.com)
# AI_API_KEY=sk_your_openai_key_here
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
#
# Option C: Together AI (https://api.together.xyz)
# AI_API_KEY=your_together_key_here
# AI_BASE_URL=https://api.together.xyz/v1
# AI_MODEL=meta-llama/Llama-3-70b-chat-hf
#
# Uncomment and fill in one set of the above, or leave all commented
# to run with rule-based responses only (fully functional, no key needed).
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# -- Backend ---------------------------------------------------------
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173

# -- Frontend --------------------------------------------------------
VITE_BACKEND_URL=http://localhost:8000
