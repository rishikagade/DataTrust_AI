# Backend environment configuration for local development.
# Copy to backend/.env and keep the real file out of git.

# Optional AI provider. Leave AI_API_KEY empty for rule-based responses.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# Comma-separated frontend origins with no trailing slash.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
